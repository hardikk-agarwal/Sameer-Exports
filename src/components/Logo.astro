---
import { site } from '../data/site';
// The company mark (flat red face of Logo/polished/sameer-exports-mark.svg).
import mark from '../data/mark.json';
---

<a href="/" class="logo" aria-label={`${site.name}, ${site.tagline}: home`}>
  <svg class="mark" viewBox={`0 0 ${mark.w} ${mark.h}`} width="25" height="36" aria-hidden="true">
    <path fill-rule="evenodd" d={mark.d}></path>
  </svg>
  <span class="words">
    <span class="name">{site.name}</span>
    <span class="tagline">{site.tagline}, Aligarh</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: inherit;
    text-decoration: none;
  }

  .logo:hover {
    color: inherit;
  }

  .mark {
    flex: none;
    width: auto;
    height: var(--mark-h, 2.25rem);
    aspect-ratio: 260 / 381;
    fill: var(--mark-fill, var(--logo-red));
    transition: fill 0.35s var(--ease-out);
  }

  .words {
    display: grid;
    line-height: 1;
  }

  .name {
    font-size: 1.0625rem;
    font-stretch: 120%;
    font-weight: 620;
    letter-spacing: 0.005em;
    white-space: nowrap;
  }

  .tagline {
    margin-top: 0.35rem;
    font-size: 0.75rem;
    font-stretch: 112%;
    font-weight: 520;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0.75;
  }

  /* Leaves room for the menu button on 320 px phones. */
  @media (max-width: 22.49rem) {
    .logo {
      gap: 0.6rem;
    }

    .name {
      font-size: 1rem;
    }

    .tagline {
      letter-spacing: 0.08em;
    }
  }
</style>
