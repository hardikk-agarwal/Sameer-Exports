---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import fontUrl from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, people } from '../data/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  footerCta?: boolean;
  /** Trail above this page, ending with it; becomes BreadcrumbList data for search results. */
  breadcrumbs?: { name: string; path: string }[];
  /** What the page opens on under the header: a photograph (default) or paper. */
  opening?: 'photo' | 'paper';
  /** The opening has its own quote button ([data-quote-here]); the header's joins once that one has scrolled away. */
  quoteInOpening?: boolean;
}

const { title, description, noindex = false, footerCta = true, breadcrumbs, opening = 'photo', quoteInOpening = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL('/og.jpg', site.url).href;

const org = {
  '@type': 'LocalBusiness',
  '@id': `${site.url}/#business`,
  name: site.name,
  alternateName: site.tagline,
  description: "Manufacturer and exporter of builders' hardware in brass and iron: door handles, door fittings, security chain locks, bolts and latches, window fittings, cabinet hardware and hooks.",
  url: site.url,
  logo: `${site.url}/logo.png`,
  image: ogImage,
  sameAs: site.profiles,
  foundingDate: String(site.founded),
  email: site.contact.email,
  telephone: site.contact.office,
  taxID: site.gstin,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postcode,
    addressCountry: 'IN',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.address.lat, longitude: site.address.lng },
  hasMap: site.address.map,
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      opens: '08:30',
      closes: '17:00',
    },
  ],
  contactPoint: [
    { '@type': 'ContactPoint', contactType: 'sales', telephone: site.contact.whatsappNumber, email: site.contact.email, availableLanguage: ['English', 'Hindi'] },
  ],
  founder: people.filter((p) => p.founder).map((p) => ({ '@type': 'Person', name: p.name, jobTitle: p.role })),
  employee: people.map((p) => ({ '@type': 'Person', name: p.name, jobTitle: p.role, telephone: p.phone, email: p.email })),
};
// Google takes the site name shown in results from WebSite data; the lowercase domain is its documented last fallback.
const website = {
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: `${site.url}/`,
  name: site.name,
  alternateName: [site.tagline, new URL(site.url).hostname],
  inLanguage: 'en',
  publisher: { '@id': org['@id'] },
};
const trail = breadcrumbs && {
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'Home', path: '/' }, ...breadcrumbs].map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: new URL(b.path, site.url).href,
  })),
};
const ld = { '@context': 'https://schema.org', '@graph': [org, website, ...(trail ? [trail] : [])] };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={opening === 'paper' ? '#fbfaf7' : '#14161d'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} (${site.tagline}), Aligarh`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header tone={opening} quoteInOpening={quoteInOpening} />
    <main id="main">
      <slot />
    </main>
    <Footer cta={footerCta} />
  </body>
</html>
