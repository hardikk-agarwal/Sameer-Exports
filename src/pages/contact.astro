---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, people } from '../data/site';
import { families, catalogue } from '../data/catalogue';
import { photo, portrait } from '../data/photos';

const head = photo('caliper');

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
const accessKey = import.meta.env.PUBLIC_FORM_ACCESS_KEY ?? '';
const quoteCc = people.filter((p) => p.ccQuotes).map((p) => p.email).join(',');
// The ordering steps printed in the 2026 catalogue.
const next = [
  'Note the codes, quantities and finish you need.',
  'Send the list on WhatsApp, by email or with this form.',
  'We reply with price, MOQ, packing and lead time. Samples on request.',
];
---

<Base
  title="Request a Quote | Sameer Exports, Aligarh"
  description={`Ask for prices on brass and iron hardware, wooden and bone knobs and art ware. WhatsApp ${site.contact.whatsappNumber} or email ${site.contact.email}.`}
  footerCta={false}
>
  <section class="photo-head contact-head" aria-labelledby="page-title">
    <img src={head.src} srcset={head.srcset} sizes="100vw" width={head.width} height={head.height} alt={head.alt} fetchpriority="high" decoding="async" />
    <div class="container head">
      <h1 id="page-title">Request a quote</h1>
      <p class="lede">Send the item codes, quantities and finish you need. We reply with price, MOQ, packing and lead time for your market.</p>
      <div class="quick">
        <a class="btn btn-light" href={site.contact.whatsapp} rel="noopener" target="_blank"><Icon name="whatsapp-logo" /> WhatsApp us</a>
        <a class="text-link" href={site.contact.officeHref}>Call {site.contact.office}</a>
      </div>
    </div>
  </section>

  <section class="section quote" id="quote">
    <div class="container quote-grid">
      <form
        class="form"
        novalidate
        data-quote-form
        data-endpoint={endpoint}
        data-email={site.contact.email}
        data-cc={quoteCc}
        data-whatsapp={site.contact.whatsapp}
        action={endpoint || undefined}
        method="post"
      >
        {accessKey && <input type="hidden" name="access_key" value={accessKey} />}
        <input type="hidden" name="subject" value="Quote request from brass-builders.com" />
        <p class="form-alert" role="alert" data-alert hidden></p>

        <div class="row">
          <div class="field">
            <label for="name">Your name</label>
            <input id="name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="company">Company</label>
            <input id="company" name="company" type="text" autocomplete="organization" required />
          </div>
        </div>
        <div class="row">
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="phone">Phone or WhatsApp</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" required aria-describedby="phone-help" />
            <p class="help" id="phone-help">Include the country code.</p>
          </div>
        </div>
        <div class="field">
          <label for="country">Country</label>
          <input id="country" name="country" type="text" autocomplete="country-name" required />
        </div>

        <fieldset class="field ranges">
          <legend>Ranges you are interested in <span class="optional">(optional)</span></legend>
          <div class="range-groups">
            {
              families.map((f) => (
                <details class="range-group" data-group data-family={f.id}>
                  <summary>
                    {f.name} <span class="group-count">{f.ranges.length} ranges</span>
                  </summary>
                  <div class="range-grid">
                    {f.ranges.map((r) => (
                      <label class="check">
                        <input type="checkbox" name="ranges" value={r.title} data-range={r.id} />
                        <span>{r.name}</span>
                      </label>
                    ))}
                  </div>
                </details>
              ))
            }
          </div>
        </fieldset>

        <div class="field">
          <label for="message">What do you need?</label>
          <textarea id="message" name="message" rows="6" required aria-describedby="message-help"></textarea>
          <p class="help" id="message-help">
            Item codes, quantities, finish and destination port. Find codes on the <a href="/products/">product pages</a> or in the <a href={catalogue.href} download={catalogue.file}>catalogue (PDF)</a>.
          </p>
        </div>

        <div class="trap" aria-hidden="true">
          <label for="website">Leave this empty</label>
          <input id="website" name="botcheck" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="submit-row">
          <button class="btn btn-primary" type="submit" data-submit>
            <span data-label>Send request</span>
          </button>
          <p class="muted small" data-mode-note>{endpoint ? 'We reply by email or WhatsApp.' : 'This opens your email app with the request filled in.'}</p>
        </div>
      </form>

      <div class="sent" data-sent hidden tabindex="-1">
        <Icon name="check" size="32" />
        <h2 data-sent-title>Request ready</h2>
        <p class="body" data-sent-text></p>
        <div class="actions">
          <a class="btn btn-outline" data-whatsapp-send href={site.contact.whatsapp} rel="noopener" target="_blank"><Icon name="whatsapp-logo" /> Send on WhatsApp instead</a>
          <button class="btn btn-outline" type="button" data-reset>Start a new request</button>
        </div>
      </div>

      <aside class="direct" aria-labelledby="direct-title">
        <h2 id="direct-title" class="direct-title">Or talk to us directly</h2>
        <ul role="list" class="people">
          {
            people.map((p) => {
              const img = portrait(p.id);
              return (
                <li class="person">
                  <img src={img.src} srcset={img.srcset} sizes="4.5rem" width={img.width} height={img.height} alt="" loading="lazy" decoding="async" />
                  <div class="person-copy">
                    <p class="person-name">{p.name}</p>
                    <p class="label">{p.role}</p>
                    <p class="person-links">
                      <a href={p.phoneHref}>{p.phone}</a>
                      {p.whatsapp && (
                        <a href={p.whatsapp} rel="noopener" target="_blank">
                          WhatsApp<span class="visually-hidden"> {p.name}</span>
                        </a>
                      )}
                      <a href={`mailto:${p.email}`}>{p.email}</a>
                    </p>
                  </div>
                </li>
              );
            })
          }
        </ul>
        <ul role="list" class="channels">
          <li>
            <a href={site.contact.whatsapp} rel="noopener" target="_blank">
              <Icon name="whatsapp-logo" size="22" />
              <span><span class="label">WhatsApp</span>{site.contact.whatsappNumber}</span>
            </a>
          </li>
          <li>
            <a href={site.contact.officeHref}>
              <Icon name="phone" size="22" />
              <span><span class="label">Office</span>{site.contact.office}</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${site.contact.email}`}>
              <Icon name="envelope-simple" size="22" />
              <span><span class="label">Email</span>{site.contact.email}</span>
            </a>
          </li>
          <li>
            <a href={site.address.map} rel="noopener" target="_blank">
              <Icon name="map-pin" size="22" />
              <span>
                <span class="label">Factory</span>
                {site.address.street}, {site.address.city} {site.address.postcode}, {site.address.region}, {site.address.country}
              </span>
            </a>
          </li>
          <li class="static">
            <Icon name="clock" size="22" />
            <span><span class="label">Hours</span>{site.hours}</span>
          </li>
        </ul>
        <div class="next">
          <h3>What happens next</h3>
          <ol role="list">
            {next.map((n, i) => <li><span class="code">{i + 1}</span>{n}</li>)}
          </ol>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-quote-form]');
  const sent = document.querySelector<HTMLElement>('[data-sent]');

  if (form && sent) {
    const endpoint = form.dataset.endpoint ?? '';
    const email = form.dataset.email ?? '';
    const cc = form.dataset.cc ?? '';
    const whatsapp = form.dataset.whatsapp ?? '';
    const alertBox = form.querySelector<HTMLElement>('[data-alert]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = submit.querySelector<HTMLElement>('[data-label]')!;
    const params = new URLSearchParams(location.search);

    // Pre-select whatever the visitor clicked to get here, and open its group.
    const range = params.get('range');
    const picked = range ? form.querySelector<HTMLInputElement>(`[data-range="${CSS.escape(range)}"]`) : null;
    if (picked) {
      picked.checked = true;
      picked.closest('details')?.setAttribute('open', '');
    }
    const family = params.get('family');
    if (family) form.querySelector(`details[data-family="${CSS.escape(family)}"]`)?.setAttribute('open', '');

    // A quote list picked on the range pages fills the message and ticks its ranges.
    const QUOTE_KEY = 'se-quote-list';
    let quote: { code: string; name: string; range: string }[] = [];
    try {
      const saved = JSON.parse(localStorage.getItem(QUOTE_KEY) ?? '[]');
      if (Array.isArray(saved)) quote = saved;
    } catch {
      quote = [];
    }
    const messageField = form.querySelector<HTMLTextAreaElement>('#message');
    if (quote.length && messageField && !messageField.value) {
      messageField.value = `Please quote for:\n${quote.map((q) => `${q.code} ${q.name}, quantity: `).join('\n')}\n\nFinish:\nDestination port:`;
      quote.forEach((q) => {
        const box = form.querySelector<HTMLInputElement>(`[data-range="${CSS.escape(q.range)}"]`);
        if (box) {
          box.checked = true;
          box.closest('details')?.setAttribute('open', '');
        }
      });
    }

    const messages: Record<string, string> = {
      valueMissing: 'Please fill this in.',
      typeMismatch: 'Please enter a valid email address.',
    };

    const showError = (field: HTMLInputElement | HTMLTextAreaElement) => {
      const wrap = field.closest('.field');
      if (!wrap) return;
      let err = wrap.querySelector<HTMLElement>('.error');
      if (field.validity.valid) {
        field.removeAttribute('aria-invalid');
        err?.remove();
        field.setAttribute('aria-describedby', (field.getAttribute('aria-describedby') ?? '').replace(/\s*\S+-error/, '').trim());
        return;
      }
      const id = `${field.id}-error`;
      if (!err) {
        err = document.createElement('p');
        err.className = 'error';
        err.id = id;
        wrap.append(err);
      }
      err.textContent = field.validity.typeMismatch ? messages.typeMismatch : messages.valueMissing;
      field.setAttribute('aria-invalid', 'true');
      const described = new Set((field.getAttribute('aria-describedby') ?? '').split(/\s+/).filter(Boolean));
      described.add(id);
      field.setAttribute('aria-describedby', [...described].join(' '));
    };

    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[required], textarea[required]')];
    fields.forEach((f) => {
      f.addEventListener('blur', () => f.value && showError(f));
      f.addEventListener('input', () => f.hasAttribute('aria-invalid') && showError(f));
    });

    const compose = (data: FormData) => {
      const ranges = data.getAll('ranges').join(', ') || 'Not specified';
      return [
        `Name: ${data.get('name')}`,
        `Company: ${data.get('company')}`,
        `Email: ${data.get('email')}`,
        `Phone: ${data.get('phone')}`,
        `Country: ${data.get('country')}`,
        `Ranges: ${ranges}`,
        '',
        String(data.get('message') ?? ''),
      ].join('\n');
    };

    const showSent = (title: string, text: string, body: string) => {
      form.hidden = true;
      sent.hidden = false;
      sent.querySelector<HTMLElement>('[data-sent-title]')!.textContent = title;
      sent.querySelector<HTMLElement>('[data-sent-text]')!.textContent = text;
      sent.querySelector<HTMLAnchorElement>('[data-whatsapp-send]')!.href = `${whatsapp}?text=${encodeURIComponent(body)}`;
      sent.focus();
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      alertBox.hidden = true;
      fields.forEach(showError);
      const firstInvalid = fields.find((f) => !f.validity.valid);
      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }
      const data = new FormData(form);
      if (data.get('botcheck')) return;
      const body = compose(data);

      if (!endpoint) {
        const subject = `Quote request: ${data.get('company')} (${data.get('country')})`;
        location.href = `mailto:${email}?${cc ? `cc=${cc}&` : ''}subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        showSent('Request ready to send', `Your email app should now be open with the request filled in. Press send there. If nothing opened, write to ${email} or use WhatsApp.`, body);
        return;
      }

      submit.disabled = true;
      label.textContent = 'Sending…';
      try {
        const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        showSent('Request sent', 'Thank you. Your request has reached us and we will reply by email or WhatsApp.', body);
        form.reset();
        try {
          localStorage.removeItem(QUOTE_KEY);
        } catch {
          // Storage may be unavailable; nothing to clear then.
        }
      } catch {
        alertBox.textContent = `We could not send your request just now. Please try again, or email ${email}.`;
        alertBox.hidden = false;
        alertBox.focus();
      } finally {
        submit.disabled = false;
        label.textContent = 'Send request';
      }
    });

    sent.querySelector('[data-reset]')?.addEventListener('click', () => {
      sent.hidden = true;
      form.hidden = false;
      form.querySelector<HTMLInputElement>('input:not([type=hidden])')?.focus();
    });
  }
</script>

<style>
  .contact-head {
    min-height: clamp(26rem, 58svh, 36rem);
  }

  .contact-head > img {
    object-position: 50% 65%;
  }

  .head {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }

  .head .lede {
    max-width: 46ch;
  }

  .quick {
    display: none;
  }

  @media (max-width: 63.99rem) {
    .quick {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem 1.75rem;
      margin-top: 0.5rem;
    }

    .quick .text-link {
      text-decoration-color: oklch(0.975 0.003 var(--hue) / 0.45);
    }
  }

  @media (max-width: 47.99rem) {
    .contact-head > img {
      object-position: 50% 50%;
    }
  }

  @media (max-width: 29.99rem) {
    .quick .btn {
      flex: 1 1 100%;
    }
  }

  .quote {
    padding-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }

  .quote-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    gap: clamp(2.5rem, 1rem + 5vw, 7rem);
    align-items: start;
  }

  .form,
  .sent {
    display: grid;
    gap: 1.5rem;
  }

  .row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .field {
    display: grid;
    gap: 0.45rem;
    align-content: start;
    min-width: 0;
  }

  label,
  legend {
    font-size: 0.9375rem;
    font-weight: 600;
    font-stretch: 104%;
  }

  .optional {
    font-weight: 450;
    color: var(--muted);
  }

  input[type='text'],
  input[type='email'],
  input[type='tel'],
  textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--line-strong);
    border-radius: 0;
    background: var(--bg);
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
    line-height: 1.45;
    transition: border-color 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
  }

  textarea {
    resize: vertical;
    min-height: 9rem;
  }

  input:hover,
  textarea:hover {
    border-color: var(--muted);
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: none;
    border-color: var(--indigo);
    box-shadow: 0 0 0 1px var(--indigo);
  }

  input[aria-invalid='true'],
  textarea[aria-invalid='true'] {
    border-color: var(--danger);
  }

  ::placeholder {
    color: var(--muted);
    opacity: 1;
  }

  .help {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .form :global(.error) {
    font-size: var(--step--1);
    font-weight: 560;
    color: var(--danger);
  }

  .form-alert {
    padding: 0.9rem 1rem;
    border: 1px solid var(--danger);
    color: var(--danger);
    font-weight: 560;
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .ranges {
    padding: 1.25rem;
    background: var(--surface);
  }

  .ranges legend {
    float: left;
    width: 100%;
    margin-bottom: 1rem;
  }

  .range-groups {
    clear: both;
    display: grid;
    border-top: 1px solid var(--line-strong);
  }

  .range-group {
    border-bottom: 1px solid var(--line-strong);
  }

  .range-group summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3rem;
    padding-block: 0.5rem;
    font-weight: 600;
    font-stretch: 104%;
    list-style: none;
    cursor: pointer;
  }

  .range-group summary::-webkit-details-marker {
    display: none;
  }

  .range-group summary::after {
    content: '';
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.25rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-0.15rem) rotate(45deg);
    transition: transform 0.25s var(--ease-out);
  }

  .range-group[open] summary::after {
    transform: translateY(0.1rem) rotate(-135deg);
  }

  .range-group summary:focus-visible {
    outline: 2px solid var(--indigo);
    outline-offset: 2px;
  }

  .group-count {
    margin-left: auto;
    font-size: var(--step--1);
    font-weight: 450;
    white-space: nowrap;
    color: var(--muted);
  }

  .range-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.1rem 1.5rem;
    padding-bottom: 1rem;
  }

  .check {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding-block: 0.2rem;
    font-weight: 450;
    cursor: pointer;
  }

  .check input {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    margin: 0.2rem 0 0;
    accent-color: var(--indigo);
  }

  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .submit-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .submit-row .btn {
    min-width: 12rem;
  }

  .submit-row .btn:disabled {
    opacity: 0.7;
    cursor: progress;
  }

  .small {
    font-size: var(--step--1);
  }

  .sent {
    align-content: start;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    background: var(--indigo-tint);
  }

  .sent:focus {
    outline: none;
  }

  .sent > :global(svg) {
    color: var(--indigo);
  }

  .sent .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .direct {
    position: sticky;
    top: calc(var(--header) + 1.5rem);
    display: grid;
    gap: 2rem;
  }

  .direct-title {
    font-size: var(--step-2);
    font-stretch: 112%;
  }

  .people {
    display: grid;
    gap: 1.25rem;
    margin: 0;
  }

  .person {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .person img {
    width: 4.5rem;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--surface-2);
  }

  .person-copy {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .person-name {
    font-size: 1.0625rem;
    font-weight: 600;
    font-stretch: 108%;
    line-height: 1.25;
  }

  .person-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    margin-top: 0.35rem;
    font-size: 0.9375rem;
  }

  .person-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    overflow-wrap: anywhere;
  }

  .channels {
    margin: 0;
    border-top: 1px solid var(--line-strong);
  }

  .channels li {
    border-bottom: 1px solid var(--line);
  }

  .channels a,
  .channels .static {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding-block: 0.9rem;
    text-decoration: none;
    line-height: 1.45;
  }

  .channels :global(svg) {
    flex: none;
    margin-top: 0.1rem;
    color: var(--indigo);
  }

  .channels .label {
    display: block;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .next {
    display: grid;
    gap: 0.9rem;
  }

  .next ol {
    display: grid;
    gap: 0.6rem;
    margin: 0;
  }

  .next li {
    display: flex;
    gap: 0.75rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .next .code {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 600;
  }

  @media (max-width: 63.99rem) {
    .quote-grid {
      grid-template-columns: 1fr;
    }

    .direct {
      position: static;
    }
  }

  @media (max-width: 39.99rem) {
    .row,
    .range-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
