---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import Finishes from '../components/Finishes.astro';
import Icon from '../components/Icon.astro';
import { families, familyCount, totalDesigns, allRanges, gallery, finishes } from '../data/catalogue';
import { site } from '../data/site';
import { photo } from '../data/photos';

// The three uses named in the opening line, one photograph each; pos keeps the fitting in frame.
const slides = [
  { id: 'doors', label: 'Doors', image: photo('teal-door'), pos: '50% 46%' },
  { id: 'windows', label: 'Windows', image: photo('window-handle'), pos: '30% 55%' },
  { id: 'cabinets', label: 'Cabinets', image: photo('cabinet-knob'), pos: '50% 80%' },
];
const family = (id: string) => families.find((f) => f.id === id)!;
// pos keeps a photo's subject in frame; zoom and origin tighten loose crops.
const cards = [
  { slot: 'a', family: family('brass'), image: photo('lever'), pos: '38% 30%', zoom: 1, origin: '50% 50%' },
  { slot: 'b', family: family('wood-bone-aluminium'), image: photo('turned-wood'), pos: '40% 50%', zoom: 1, origin: '50% 50%' },
  { slot: 'c', family: family('art-ware'), image: photo('lanterns'), pos: '50% 30%', zoom: 1, origin: '50% 50%' },
  { slot: 'd', family: family('iron'), image: photo('iron-knocker'), pos: '74% 42%', zoom: 1.3, origin: '70% 40%' },
];
const artisan = photo('artisan');
const moulds = photo('moulds');
const lock = photo('lock');
const steps = [
  { title: 'Cast', text: 'Sand casting in our own foundry keeps the fine detail of period designs.' },
  { title: 'Forge', text: 'Hot forging presses brass into dense, non-porous parts for hard daily use.' },
  { title: 'Finish', text: 'Machined, polished and lacquered in-house, part by machine and part by\u00a0hand.' },
  { title: 'Pack', text: 'Packed to export standards and to your own labels and cartons.' },
];
---

<Base
  title="Brass Door & Cabinet Hardware Manufacturer | Sameer Exports"
  description={`Brass, iron and aluminium hardware, wooden and bone knobs and art ware, made in Aligarh since ${site.founded}: ${totalDesigns} designs in ${allRanges.length} ranges.`}
  opening="paper"
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">Sameer&nbsp;Exports.<br />Brass hardware for your&nbsp;brand.</h1>
      <p class="lede">Choose from {totalDesigns} designs and {finishes.length} finishes, made in our own works in Aligarh since {site.founded} and packed under your label.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/contact/">Request a quote</a>
        <a class="text-link" href="/products/">See the range</a>
      </div>
    </div>
    <div class="show" role="group" aria-roledescription="carousel" aria-label="Photographs of door, window and cabinet hardware" data-show>
      <div class="show-bar">
        <button class="show-play" type="button" aria-label="Pause the photographs" data-play>
          <Icon name="pause-fill" size="18" class="i-pause" />
          <Icon name="play-fill" size="18" class="i-play" />
        </button>
        <div class="show-tabs" role="tablist" aria-label="Photographs">
          {
            slides.map((s, i) => (
              <button class="show-tab" type="button" role="tab" id={`show-tab-${s.id}`} aria-controls={`show-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                {s.label}
                <span class="show-time" aria-hidden="true" />
              </button>
            ))
          }
        </div>
      </div>
      <div class="show-frames" aria-live="off" data-frames>
        {
          slides.map((s, i) => (
            <div class="show-frame" id={`show-${s.id}`} role="tabpanel" aria-roledescription="slide" aria-labelledby={`show-tab-${s.id}`} aria-hidden={i === 0 ? undefined : 'true'} data-on={i === 0 ? '' : undefined}>
              <img src={s.image.src} srcset={s.image.srcset} sizes="(min-width: 64rem) 50vw, 100vw" width={s.image.width} height={s.image.height} alt={s.image.alt} style={`object-position:${s.pos}`} fetchpriority={i === 0 ? 'high' : 'low'} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section intro" aria-label="Sameer Exports in brief">
    <div class="container">
      <p class="statement display">
        From Talanagri, the lock-making quarter of Aligarh, we cast, forge and finish hardware in brass, iron, aluminium, wood and bone, and art ware, for importers, wholesalers and builders abroad.
      </p>
      <dl class="facts">
        <div><dt class="label">Founded</dt><dd>{site.founded}</dd></div>
        <div><dt class="label">Quality</dt><dd>ISO 9001 certified</dd></div>
        <div><dt class="label">Catalogue</dt><dd>{totalDesigns} designs in {allRanges.length}&nbsp;ranges</dd></div>
        <div>
          <dt class="label">Exports to</dt>
          <dd>Six countries <span class="fact-note">UK, US, Mexico, Germany, Canada and Australia</span></dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="families" id="range" aria-labelledby="range-title">
    <div class="container">
      <div class="sec-head">
        <h2 id="range-title">Four families, one maker</h2>
        <a class="text-link" href="/products/">See all {totalDesigns} designs</a>
      </div>
      <ul class="cards" role="list">
        {
          cards.map(({ slot, family, image, pos, zoom, origin }) => (
            <li class={`card card-${slot}`}>
              <a href={`/products/#${family.id}`}>
                <span class="frame drift">
                  <img src={image.src} srcset={image.srcset} sizes="(min-width: 64rem) 58vw, 100vw" width={image.width} height={image.height} alt="" loading="lazy" decoding="async" style={`object-position:${pos};--zoom:${zoom};transform-origin:${origin}`} />
                </span>
                <span class="card-copy">
                  <span class="card-name">{family.name}</span>
                  <span class="card-meta">
                    {familyCount(family)} designs in {family.ranges.length}&nbsp;ranges
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section pieces" aria-labelledby="pieces-title">
    <div class="container pieces-head">
      <h2 id="pieces-title">From the catalogue</h2>
      <a class="text-link" href="/products/">Browse the full catalogue</a>
    </div>
    <Gallery codes={gallery} id="pieces-track" label="Selected pieces from the catalogue" />
  </section>

  <section class="section craft" aria-labelledby="craft-title">
    <div class="container craft-grid">
      <div class="craft-head">
        <h2 id="craft-title">Made in our own works</h2>
        <p class="lede">Casting, forging, finishing and packing all happen under one roof in Talanagri, so the quality is ours to control from the first pour.</p>
      </div>
      <figure class="frame drift craft-a">
        <img src={artisan.src} srcset={artisan.srcset} sizes="(min-width: 64rem) 62vw, 100vw" width={artisan.width} height={artisan.height} alt={artisan.alt} loading="lazy" decoding="async" />
      </figure>
      <figure class="frame drift craft-b">
        <img src={moulds.src} srcset={moulds.srcset} sizes="(min-width: 64rem) 30vw, 100vw" width={moulds.width} height={moulds.height} alt={moulds.alt} loading="lazy" decoding="async" />
      </figure>
      <ol class="steps" role="list">
        {
          steps.map((s) => (
            <li>
              <h3>{s.title}</h3>
              <p class="muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="heritage dark" aria-labelledby="heritage-title">
    <div class="container heritage-grid">
      <div class="heritage-copy">
        <h2 id="heritage-title">Aligarh has made locks and hardware for more than a&nbsp;century.</h2>
        <p class="lede">Our works stand in Talanagri, the district named for the trade: tala means lock. The casting, filing and polishing skills our people use are the town’s own.</p>
        <a class="text-link" href="/about/">About Sameer Exports</a>
      </div>
      <figure class="frame heritage-photo">
        <img src={lock.src} srcset={lock.srcset} sizes="(min-width: 64rem) 46vw, 100vw" width={lock.width} height={lock.height} alt={lock.alt} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="section finishes" aria-labelledby="finish-title">
    <div class="container">
      <div class="fin-head">
        <h2 id="finish-title">{finishes.length} finishes</h2>
        <p class="lede">Every design has a standard finish, and most can be made in any of these on request. Pick one to see a piece from the catalogue made in it.</p>
      </div>
      <Finishes />
    </div>
  </section>
</Base>

<script>
  // Hero photographs: a tabbed carousel (WAI-ARIA APG). The line under the current tab is the timer.
  const show = document.querySelector<HTMLElement>('[data-show]');
  if (show) {
    const tabs = [...show.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const frames = [...show.querySelectorAll<HTMLElement>('[role=tabpanel]')];
    const play = show.querySelector<HTMLButtonElement>('[data-play]')!;
    const live = show.querySelector<HTMLElement>('[data-frames]')!;
    let current = 0;

    const select = (index: number, focus = false) => {
      const next = (index + tabs.length) % tabs.length;
      if (next !== current) {
        frames.forEach((frame) => frame.removeAttribute('data-was'));
        frames[current].removeAttribute('data-on');
        frames[current].setAttribute('data-was', '');
        // Commit the incoming photograph as clear first, so it fades in even if it was the one underneath.
        void frames[next].offsetWidth;
        frames[next].setAttribute('data-on', '');
        tabs.forEach((tab, i) => {
          tab.setAttribute('aria-selected', String(i === next));
          tab.tabIndex = i === next ? 0 : -1;
        });
        frames.forEach((frame, i) => (i === next ? frame.removeAttribute('aria-hidden') : frame.setAttribute('aria-hidden', 'true')));
        current = next;
      }
      if (focus) tabs[current].focus();
    };

    const setPlaying = (on: boolean) => {
      show.toggleAttribute('data-paused', !on);
      play.setAttribute('aria-label', on ? 'Pause the photographs' : 'Play the photographs');
      live.setAttribute('aria-live', on ? 'off' : 'polite');
    };

    show.addEventListener('animationend', (e) => {
      if ((e.target as HTMLElement).classList.contains('show-time')) select(current + 1);
    });
    play.addEventListener('click', () => setPlaying(show.hasAttribute('data-paused')));
    tabs.forEach((tab, i) =>
      tab.addEventListener('click', () => {
        setPlaying(false);
        select(i);
      }),
    );
    show.querySelector('[role=tablist]')!.addEventListener('keydown', (e) => {
      const { key } = e as KeyboardEvent;
      const to = { ArrowRight: current + 1, ArrowLeft: current - 1, Home: 0, End: tabs.length - 1 }[key];
      if (to === undefined) return;
      e.preventDefault();
      setPlaying(false);
      select(to, true);
    });
    // Keyboard focus inside stops the rotation until Play is pressed.
    show.addEventListener('focusin', (e) => {
      if ((e.target as HTMLElement).matches(':focus-visible')) setPlaying(false);
    });
    setPlaying(!matchMedia('(prefers-reduced-motion: reduce)').matches);
  }
</script>

<style>
  /* Hero: the words on paper beside three photographs that take turns, running off the right edge. */
  .hero {
    --pad: max(var(--gutter), calc((100% - var(--max)) / 2 + var(--gutter)));
    --dwell: 6.5s;
    display: grid;
    grid-template-columns: [full-start] var(--pad) [content-start] repeat(12, minmax(0, 1fr)) [content-end] var(--pad) [full-end];
    min-height: clamp(38rem, 100svh, 62rem);
    padding-top: var(--header);
  }

  .hero-copy {
    grid-column: content-start / span 6;
    align-self: center;
    display: grid;
    gap: 1.6rem;
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 5rem);
    padding-right: clamp(2rem, 0.5rem + 3.5vw, 5rem);
    container-type: inline-size;
  }

  /* Sized so the name, "Sameer Exports.", always fits on its own line. */
  .hero h1 {
    font-size: min(clamp(2.6rem, 0.5rem + 4.7vw, 5.2rem), 11.6cqi);
    line-height: 1;
  }

  .hero .lede {
    max-width: 34ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 0.75rem;
  }

  .show {
    grid-column: 8 / full-end;
    display: grid;
    grid-template: 'frames' minmax(0, 1fr) 'bar' auto / minmax(0, 1fr);
  }

  .show-frames {
    grid-area: frames;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--surface-2);
  }

  .show-frame {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  /* The outgoing photograph stays underneath until the incoming one has faded in over it. */
  .show-frame[data-was] {
    z-index: 1;
    opacity: 1;
  }

  .show-frame[data-on] {
    z-index: 2;
    opacity: 1;
    transition: opacity 1.2s var(--ease-out);
  }

  .show-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .show-bar {
    grid-area: bar;
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.5rem;
    padding-right: var(--pad);
  }

  .show-play {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    margin-left: -0.65rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-2);
    cursor: pointer;
    transition: color 0.2s var(--ease-out);
  }

  .show-play:hover {
    color: var(--ink);
  }

  .show[data-paused] .show-play :global(.i-pause),
  .show:not([data-paused]) .show-play :global(.i-play) {
    display: none;
  }

  .show-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
  }

  .show-tab {
    position: relative;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.9375rem;
    font-stretch: 108%;
    font-weight: 560;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s var(--ease-out);
  }

  .show-tab:hover,
  .show-tab[aria-selected='true'] {
    color: var(--ink);
  }

  /* Fills while the tab's photograph shows; when full, the next one fades in. Full and still when paused. */
  .show-time {
    position: absolute;
    inset: auto 0 0.3rem;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
  }

  .show-tab[aria-selected='true'] .show-time {
    animation: dwell var(--dwell) linear forwards;
  }

  .show[data-paused] .show-tab[aria-selected='true'] .show-time {
    animation: none;
    transform: none;
  }

  @media (hover: hover) {
    .show:has(.show-frames:hover) .show-time {
      animation-play-state: paused;
    }
  }

  @keyframes dwell {
    to {
      transform: none;
    }
  }

  /* Reduced motion starts paused; if Play is pressed, the timer still runs at its real length. */
  @media (prefers-reduced-motion: reduce) {
    .show-time {
      animation-duration: var(--dwell) !important;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .show-frame[data-on] img {
      animation: settle 1.8s var(--ease-out) both;
    }

    .hero-copy > * {
      animation: rise 1s var(--ease-out) both;
    }

    .hero-copy > :nth-child(2) {
      animation-delay: 0.12s;
    }

    .hero-copy > :nth-child(3) {
      animation-delay: 0.24s;
    }
  }

  @keyframes settle {
    from {
      transform: scale(1.04);
    }
  }

  @keyframes rise {
    from {
      transform: translateY(1.25rem);
    }
  }

  /* Intro */
  .statement {
    max-width: 34ch;
    font-size: clamp(1.6rem, 1.1rem + 1.6vw, 2.4rem);
    line-height: 1.22;
    letter-spacing: -0.015em;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem var(--gutter);
    margin-top: clamp(3rem, 2rem + 4vw, 5.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .facts div {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .facts dd {
    font-size: var(--step-2);
    font-stretch: 112%;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .fact-note {
    display: block;
    margin-top: 0.45rem;
    font-size: 0.9375rem;
    font-stretch: 100%;
    line-height: 1.45;
    letter-spacing: 0;
    color: var(--muted);
  }

  /* Families: four photographs in two rows of unequal widths */
  .families {
    padding-bottom: var(--section);
  }

  .sec-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.25rem);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: clamp(24rem, 18rem + 16vw, 40rem) clamp(22rem, 16rem + 13vw, 34rem);
    gap: clamp(0.75rem, 0.5rem + 0.8vw, 1.25rem);
    margin: 0;
  }

  .card-a {
    grid-column: 1 / span 7;
  }

  .card-b {
    grid-column: 8 / -1;
  }

  .card-c {
    grid-column: 1 / span 5;
  }

  .card-d {
    grid-column: 6 / -1;
  }

  .card a {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    color: var(--on-dark);
    text-decoration: none;
  }

  .card .frame {
    position: absolute;
    inset: 0;
  }

  .card img {
    scale: var(--zoom);
    transition: scale 1s var(--ease-out);
  }

  .card a:hover img {
    scale: calc(var(--zoom) * 1.04);
  }

  /* Darken only the label zone so the photographs keep their own colour. */
  .card a::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      0deg,
      oklch(0.12 0.02 var(--hue) / 0.88),
      oklch(0.12 0.02 var(--hue) / 0.7) 5.5rem,
      oklch(0.12 0.02 var(--hue) / 0.3) 10rem,
      transparent 14rem
    );
  }

  .card-copy {
    position: absolute;
    left: clamp(1.25rem, 1rem + 1vw, 2rem);
    right: clamp(1.25rem, 1rem + 1vw, 2rem);
    bottom: clamp(1.25rem, 1rem + 1vw, 2rem);
    z-index: 1;
    display: grid;
    gap: 0.35rem;
    text-shadow: 0 1px 14px oklch(0.1 0.02 var(--hue) / 0.45);
  }

  .card-name {
    font-size: var(--step-2);
    font-stretch: 112%;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .card-meta {
    font-size: 0.9375rem;
    color: var(--on-dark-2);
  }

  .card a:focus-visible {
    outline: 3px solid var(--indigo);
    outline-offset: 3px;
  }

  /* Catalogue rail */
  .pieces {
    padding-top: 0;
    overflow: hidden;
  }

  .pieces-head {
    display: grid;
    justify-items: start;
    gap: 1rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  /* Craft */
  .craft {
    padding-top: 0;
  }

  .craft-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto clamp(20rem, 12rem + 24vw, 40rem) auto;
    gap: clamp(1.5rem, 1rem + 2vw, 3rem) clamp(0.75rem, 0.5rem + 0.8vw, 1.25rem);
  }

  .craft-head {
    grid-column: 1 / span 7;
    display: grid;
    gap: 1.25rem;
  }

  .craft-a {
    grid-column: 1 / span 8;
  }

  .craft-a img {
    object-position: 50% 70%;
  }

  .craft-b {
    grid-column: 9 / -1;
  }

  .steps {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem var(--gutter);
    margin: 0;
  }

  .steps li {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line-strong);
  }

  /* Heritage */
  .heritage {
    padding-block: var(--section);
  }

  .heritage-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 3rem clamp(0.75rem, 0.5rem + 0.8vw, 1.25rem);
    align-items: start;
  }

  .heritage-copy {
    grid-column: 1 / span 6;
    display: grid;
    justify-items: start;
    gap: 1.5rem;
    padding-right: clamp(0rem, 2vw, 2.5rem);
  }

  .heritage-photo {
    grid-column: 7 / -1;
    aspect-ratio: 5 / 4;
    background: var(--night-2);
  }

  .heritage-photo img {
    object-position: 50% 68%;
    filter: brightness(1.12) contrast(1.04);
  }

  /* Finishes */
  .fin-head {
    display: grid;
    gap: 1.25rem;
    max-width: 46rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  @media (max-width: 63.99rem) {
    .hero {
      display: block;
      min-height: 0;
    }

    .hero-copy {
      max-width: calc(40rem + 2 * var(--gutter));
      padding: clamp(2rem, 1.5rem + 3vw, 3.5rem) var(--gutter) clamp(2.5rem, 2rem + 3vw, 4rem);
    }

    .show-frames {
      aspect-ratio: 3 / 2;
    }

    .show-bar {
      padding-inline: var(--gutter);
    }

    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cards {
      grid-template-rows: none;
      grid-auto-rows: clamp(20rem, 14rem + 22vw, 28rem);
    }

    .card-a,
    .card-b,
    .card-c,
    .card-d {
      grid-column: span 6;
    }

    .craft-head {
      grid-column: 1 / -1;
    }

    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .heritage-copy,
    .heritage-photo {
      grid-column: 1 / -1;
    }

    .heritage-copy {
      padding-right: 0;
