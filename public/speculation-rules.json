{
  "prefetch": [
    {
      "source": "document",
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "not": { "href_matches": "/catalogue/*" } },
          { "not": { "selector_matches": "[download], [rel~=nofollow]" } }
        ]
      },
      "eagerness": "moderate"
    }
  ]
}
